<?php if (!($zone_exists ?? false)) { ?>
<div class="alert alert-info"><?php $this->_('OpenProvider.tab_dns.no_zone'); ?></div>
<?php } else { ?>

<div class="row panel-fix">
    <div class="col-md-12">
        <h4><?php $this->_('OpenProvider.tab_dns.title_list'); ?></h4>

        <div class="table-responsive my-2">
            <table class="table table-curved table-striped">
                <thead>
                    <tr class="heading_row">
                        <th><span><?php $this->_('OpenProvider.tab_dns.field.name'); ?></span></th>
                        <th><span><?php $this->_('OpenProvider.tab_dns.field.type'); ?></span></th>
                        <th><span><?php $this->_('OpenProvider.tab_dns.field.value'); ?></span></th>
                        <th><span><?php $this->_('OpenProvider.tab_dns.field.prio'); ?></span></th>
                        <th><span><?php $this->_('OpenProvider.tab_dns.field.ttl'); ?></span></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach (($records ?? []) as $record) { ?>
                    <tr>
                        <td><?php echo $this->Html->safe($record['name'] ?? null); ?></td>
                        <td><?php echo $this->Html->safe($record['type'] ?? null); ?></td>
                        <td><?php echo $this->Html->safe($record['value'] ?? null); ?></td>
                        <td><?php echo $this->Html->safe(empty($record['prio']) ? null : $record['prio']); ?></td>
                        <td><?php echo $this->Html->safe($record['ttl'] ?? null); ?></td>
                        <td>
                            <?php
                            $this->Form->create();
                            $this->Form->fieldHidden('name', $record['name'] ?? null);
                            $this->Form->fieldHidden('type', $record['type'] ?? null);
                            $this->Form->fieldHidden('value', $record['value'] ?? null);
                            $this->Form->fieldHidden('prio', $record['prio'] ?? null);
                            $this->Form->fieldHidden('ttl', $record['ttl'] ?? null);
                            $this->Form->fieldButton('action', $this->_('OpenProvider.tab_dns.field.delete', true), [
                                'class' => 'btn btn-sm btn-danger',
                                'value' => 'delete',
                                'type' => 'submit',
                            ]);
                            $this->Form->end();
                            ?>
                        </td>
                    </tr>
                    <?php } ?>
                </tbody>
            </table>
        </div>

        <h4 class="mt-3"><?php $this->_('OpenProvider.tab_dns.title_add'); ?></h4>
        <p><?php $this->_('OpenProvider.tab_dns.help_text'); ?></p>

        <?php $this->Form->create(); ?>
        <div class="form-row">
            <div class="form-group col-md-3">
                <?php $this->Form->label($this->_('OpenProvider.tab_dns.field.name', true), 'name'); ?>
                <?php $this->Form->fieldText('name', $vars->name ?? null, [
                    'id' => 'name',
                    'class' => 'form-control',
                    'placeholder' => $domain ?? null,
                ]); ?>
            </div>
            <div class="form-group col-md-2">
                <?php $this->Form->label($this->_('OpenProvider.tab_dns.field.type', true), 'type'); ?>
                <?php $this->Form->fieldSelect('type', $record_types ?? [], $vars->type ?? null, [
                    'id' => 'type',
                    'class' => 'form-control',
                ]); ?>
            </div>
            <div class="form-group col-md-3">
                <?php $this->Form->label($this->_('OpenProvider.tab_dns.field.value', true), 'value'); ?>
                <?php $this->Form->fieldText('value', $vars->value ?? null, [
                    'id' => 'value',
                    'class' => 'form-control',
                ]); ?>
            </div>
            <div class="form-group col-md-2">
                <?php $this->Form->label($this->_('OpenProvider.tab_dns.field.prio', true), 'prio'); ?>
                <?php $this->Form->fieldText('prio', $vars->prio ?? null, [
                    'id' => 'prio',
                    'class' => 'form-control',
                ]); ?>
            </div>
            <div class="form-group col-md-2">
                <?php $this->Form->label($this->_('OpenProvider.tab_dns.field.ttl', true), 'ttl'); ?>
                <?php $this->Form->fieldText('ttl', $vars->ttl ?? 3600, [
                    'id' => 'ttl',
                    'class' => 'form-control',
                ]); ?>
            </div>
        </div>
        <button class="btn btn-light float-right" type="submit" name="action" value="add">
            <i class="fas fa-plus"></i> <?php $this->_('OpenProvider.tab_dns.field.add'); ?>
        </button>
        <?php $this->Form->end(); ?>
    </div>
</div>

<?php } ?>
