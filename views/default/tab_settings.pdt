<?php /** @var View $this **/ ?>

<div>
    <?php
$this->Form->create(null, ['id' => 'tab-settings-form']);
?>

    <?php if (isset($vars->epp) && $vars->epp) { ?>
    <div class="mb-3">
        <?php $this->Form->label($this->_('OpenProvider.tab_settings.field.epp', true), 'epp', [
            'class' => 'form-label',
        ]); ?>
        <div class="input-group">
            <?php $this->Form->fieldText('epp', $vars->epp ?? null, [
                'id' => 'epp',
                'class' => 'form-control epp-input',
                'placeholder' => $this->_('OpenProvider.tab_settings.field.epp', true),
                'disabled' => 'true',
                'type' => 'password',
            ]); ?>
            <span class="input-group-text show-hide-epp btn"><i class="bi bi-eye"></i></span>
            <span class="input-group-text generate-new-epp btn" data-bs-toggle="tooltip" data-bs-html="true" title="reset your auth code"><i class="bi bi-arrow-clockwise"></i></span>
        </div>
        <?php $this->Form->fieldHidden('generate-new-epp', '', ['id' => 'generate-new-epp']); ?>
    </div>
    <?php } ?>
    <div class="mb-3">
        <div class="form-check form-switch">
            <?php $this->Form->fieldCheckbox(
                'is_locked',
                'true',
                isset($vars->is_locked) ? $vars->is_locked == 'true' : false,
                ['id' => 'is_locked', 'class' => 'form-check-input is_locked-switch'],
            ); ?>
            <?php $this->Form->label(
                $this->_('OpenProvider.tab_settings.field.is_locked' . '_' . $vars->is_locked, true),
                'is_locked',
                ['class' => 'form-check-label'],
            ); ?>
        </div>
        <?php $this->Form->fieldHidden('lock', '', ['id' => 'lock']); ?>
    </div>

    <?php $this->Form->end(); ?>
</div>

<script>
    var generateNewAuthCodeButtonClickCount = 0;

    var tooltip_el = document.querySelector('.generate-new-epp[data-bs-toggle="tooltip"]');
    if (tooltip_el) new bootstrap.Tooltip(tooltip_el);

    document.querySelector('.show-hide-epp').addEventListener('click', function() {
        let icon = this.querySelector('i');
        if (icon.classList.contains('bi-eye')) {
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
            document.querySelector('.epp-input').type = 'text';
        } else {
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
            document.querySelector('.epp-input').type = 'password';
        }
    });

    document.querySelector('.generate-new-epp').addEventListener('click', function() {
        document.querySelector('input[name="generate-new-epp"]').value = 'true';

        let icon = this.querySelector('i');
        icon.innerHTML = '  click again to reset your auth code';
        icon.parentElement.classList.add('btn-success');

        if (tooltip_el) {
            var tooltip = bootstrap.Tooltip.getInstance(tooltip_el);
            if (tooltip) tooltip.disable();
        }

        if (++generateNewAuthCodeButtonClickCount == 2) {
            document.getElementById('tab-settings-form').submit();
        }
    });

    document.querySelector('.is_locked-switch').addEventListener('click', function() {
        document.querySelector('input[name="lock"]').value = this.checked ? 'true' : 'false';
        document.getElementById('tab-settings-form').submit();
    });
</script>
