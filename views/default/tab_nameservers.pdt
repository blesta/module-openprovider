<?php /** @var View $this **/ ?>

<?php
$this->Form->create();
?>

<div>
    <?php for ($i = 0; $i < 5; $i++) { ?>
    <div class="mb-3">
        <?php $this->Form->label($this->_('OpenProvider.tab_nameserver.field_ns', true, $i + 1), 'ns' . ($i + 1), [
            'class' => 'form-label',
        ]); ?>
        <?php $this->Form->fieldText('ns[]', $vars->ns[$i] ?? null, [
            'id' => 'ns' . ($i + 1),
            'class' => 'form-control',
            'placeholder' => $this->_('OpenProvider.tab_nameserver.field_ns', true, $i + 1),
        ]); ?>
    </div>
    <?php } ?>
</div>
<div class="d-flex justify-content-end">
    <button class="btn btn-primary" type="submit">
        <i class="bi bi-pencil"></i> <?php $this->_('OpenProvider.tab_nameservers.field_submit'); ?>
    </button>
</div>

<?php $this->Form->end(); ?>
