<?php /** @var View $this **/ ?>

<?php
$link_buttons[] = [
    'name' => $this->_('OpenProvider.manage.add_row_btn', true),
    'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . $module->id],
];

$this->Widget->clear();
$this->Widget->setLinkButtons($link_buttons);
$this->Widget->setBodyWrapper(false);
$this->Widget->create(
    $this->_('AdminCompanyModules.manage.boxtitle_manage', true, $this->Html->safe($module->name ?? null)),
    ['id' => 'manage_openprovider'],
);
?>

    <?php
    $num_rows = count($module->rows ?? []);
    if ($num_rows > 0) { ?>
<table class="table">
    <thead>
        <tr>
            <th><span><?php $this->_('OpenProvider.manage.module_rows_header.username'); ?></span></th>
            <th><span><?php $this->_('OpenProvider.manage.module_rows_header.test_mode'); ?></span></th>
            <th><span><?php $this->_('OpenProvider.manage.module_rows_header.options'); ?></span></th>
        </tr>
    </thead>
    <tbody>
        <?php for ($i = 0; $i < $num_rows; $i++) { ?>
        <tr>
            <td><?php echo $this->Html->safe($module->rows[$i]->meta->username ?? null); ?></td>
            <td><?php echo $this->_(
                'OpenProvider.row_meta.test_mode_' . ($module->rows[$i]->meta->test_mode ?? 'false'),
            ); ?></td>
            <td>
                <a href="<?php echo $this->Html->safe(
                    $this->base_uri .
                        'settings/company/modules/editrow/' .
                        ($module->id ?? null) .
                        '/' .
                        ($module->rows[$i]->id ?? null) .
                        '/',
                ); ?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_(
    'OpenProvider.manage.module_rows.edit',
); ?>">
                    <i class="bi bi-pencil"></i>
                </a>

                <?php
                $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/', ['class' => 'd-inline']);
                $this->Form->fieldHidden('id', $module->id ?? null);
                $this->Form->fieldHidden('row_id', $module->rows[$i]->id ?? null);
                ?>
                <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete"
                    data-confirm-message="<?php echo $this->Html->safe(
                        $this->_('OpenProvider.manage.module_rows.confirm_delete', true),
                    ); ?>"
                    title="<?php $this->_('OpenProvider.manage.module_rows.delete'); ?>">
                    <i class="bi bi-trash"></i>
                </button>
                <?php $this->Form->end(); ?>
            </td>
        </tr>
                <?php } ?>
    </tbody>
</table>
                <?php } else { ?>
<div class="card-body text-center text-muted py-5">
    <i class="bi bi-globe" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('OpenProvider.manage.module_rows_no_results'); ?></p>
</div>
                <?php }
    ?>

                <?php $this->Widget->end(); ?>
