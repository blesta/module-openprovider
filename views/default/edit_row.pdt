<?php /** @var View $this **/ ?>

<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Openprovider.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . $module->id],
    ],
]);
$this->Form->create(null, ['class' => 'disable-on-submit']);
$this->Widget->create($this->_('OpenProvider.edit_row.box_title', true));
?>

<h6 class="form-section-header"><?php $this->_('OpenProvider.edit_row.basic_title'); ?></h6>

<div class="mb-3">
    <label for="username" class="form-label">
        <?php $this->_('OpenProvider.row_meta.username'); ?>
    </label>
    <?php $this->Form->fieldText('username', $vars->username ?? null, [
        'id' => 'username',
        'class' => 'form-control',
    ]); ?>
</div>

<div class="mb-3">
    <label for="password" class="form-label">
        <?php $this->_('OpenProvider.row_meta.password'); ?>
    </label>
    <?php $this->Form->fieldText('password', $vars->password ?? null, [
        'id' => 'password',
        'class' => 'form-control',
        'type' => 'password',
    ]); ?>
</div>

<div class="mb-3">
    <div class="form-check">
        <?php $this->Form->fieldCheckbox('test_mode', 'true', ($vars->test_mode ?? null) == 'true', [
            'id' => 'test_mode',
            'class' => 'form-check-input',
        ]); ?>
        <label for="test_mode" class="form-check-label">
            <?php $this->_('OpenProvider.row_meta.test_mode'); ?>
        </label>
    </div>
</div>

<?php $this->Form->fieldHidden('openprovider_module', true); ?>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end">
    <button type="submit" class="btn btn-primary"><?php $this->_('OpenProvider.edit_row.add_btn'); ?></button>
</div>

<?php
$this->Widget->end();
$this->Form->end();


?>
